# Server-only values. Never prefix these with VITE_ or commit real credentials.

# --- Local development (default) ---------------------------------------------
# Leave the TURSO_* values empty and the API uses a local SQLite file at
# instance/agri.sqlite3. Set SQLITE_PATH to use a different file.
SQLITE_PATH=
# 1 = create/upgrade the tables automatically when the API starts (local SQLite only).
AUTO_MIGRATE=1

# --- Production on Vercel (required there; Vercel's disk is not persistent) ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Key the embedded device sends as "Authorization: Bearer <key>" to POST detections/sprays.
DEVICE_API_KEY=replace-with-a-long-random-device-key

# Optional: comma-separated frontend origins only when API and frontend are separate.
ALLOWED_ORIGINS=

# Optional: how long a detection remains "current" on live camera overlays.
CURRENT_DETECTION_WINDOW_SECONDS=30
